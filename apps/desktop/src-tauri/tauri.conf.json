{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LazyBuddy",
  "version": "1.0.3",
  "identifier": "dev.lazybuddy.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LazyBuddy",
        "width": 780,
        "height": 540,
        "minWidth": 440,
        "minHeight": 440,
        "decorations": false,
        "shadow": false,
        "visible": false,
        "focus": false,
        "skipTaskbar": true,
        "transparent": true,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' http://127.0.0.1:*; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'",
      "capabilities": [
        {
          "identifier": "shell",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:window:allow-start-dragging",
            "core:event:allow-listen",
            "core:event:allow-unlisten"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../../assets/lazybuddy.ico"
    ]
  }
}
